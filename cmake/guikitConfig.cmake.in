@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(keel)
if (@GUIKIT_HAS_KEEL_IMAGEFILE@)
    find_dependency(keel_imagefile)
endif()

if (NOT EMSCRIPTEN)
    find_dependency(Threads)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/guikitTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/GuiKitGuidelines.cmake")
check_required_components(guikit)
