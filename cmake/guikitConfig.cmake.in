@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(keel)

if (@GUIKIT_BUILD_SCENES@)
    if (NOT WIN32 AND NOT EMSCRIPTEN)
        find_package(CURL QUIET)
    endif()
    find_dependency(keel_http)
endif()

if (NOT EMSCRIPTEN)
    find_dependency(Threads)
endif()

if (@GUIKIT_BUILD_BACKEND_THORVG@ AND NOT @GUIKIT_BUNDLED_THORVG@)
    find_dependency(thorvg)
endif()

if (@GUIKIT_BUILD_BACKEND_SDL3@)
    find_dependency(SDL3 CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/guikitTargets.cmake")
check_required_components(guikit)
