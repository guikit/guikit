# ==============================================================================
# GenerateEmbeddedAssets.cmake
# Generates a C++20 translation unit containing embedded binary assets from
# ${ASSETS_DIR} so that fonts, images, and icons are compiled directly into
# both native executables and WebAssembly (.wasm) binaries.
# ==============================================================================

if (NOT DEFINED ASSETS_DIR)
    message(FATAL_ERROR "GenerateEmbeddedAssets.cmake: ASSETS_DIR is not defined")
endif()

if (NOT DEFINED OUTPUT_FILE)
    message(FATAL_ERROR "GenerateEmbeddedAssets.cmake: OUTPUT_FILE is not defined")
endif()

get_filename_component(OUTPUT_DIR "${OUTPUT_FILE}" DIRECTORY)
file(MAKE_DIRECTORY "${OUTPUT_DIR}")

if (EXISTS "${ASSETS_DIR}")
    file(GLOB_RECURSE REL_ASSET_FILES RELATIVE "${ASSETS_DIR}" "${ASSETS_DIR}/*")
    list(SORT REL_ASSET_FILES)
else()
    set(REL_ASSET_FILES "")
endif()

set(CPP_OUT "// Auto-generated by cmake/GenerateEmbeddedAssets.cmake. DO NOT EDIT.\n")
string(APPEND CPP_OUT "#include \"guikit/core/Assets.hpp\"\n")
string(APPEND CPP_OUT "#include <array>\n\n")
string(APPEND CPP_OUT "namespace guikit::detail {\n\n")
string(APPEND CPP_OUT "namespace {\n\n")

set(ENTRY_ROWS "")
set(ASSET_IDX 0)

function(guikit_hex_to_c_array HEX_STR OUT_VAR)
    string(LENGTH "${HEX_STR}" LEN)
    if (LEN LESS_EQUAL 4096)
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," BYTES "${HEX_STR}")
        set(${OUT_VAR} "    ${BYTES}\n" PARENT_SCOPE)
        return()
    endif()
    math(EXPR HALF "(${LEN} / 4) * 2")
    math(EXPR REST "${LEN} - ${HALF}")
    string(SUBSTRING "${HEX_STR}" 0 ${HALF} LEFT_HEX)
    string(SUBSTRING "${HEX_STR}" ${HALF} ${REST} RIGHT_HEX)
    guikit_hex_to_c_array("${LEFT_HEX}" LEFT_OUT)
    guikit_hex_to_c_array("${RIGHT_HEX}" RIGHT_OUT)
    set(${OUT_VAR} "${LEFT_OUT}${RIGHT_OUT}" PARENT_SCOPE)
endfunction()

foreach(REL_PATH IN LISTS REL_ASSET_FILES)
    set(FULL_PATH "${ASSETS_DIR}/${REL_PATH}")
    if (IS_DIRECTORY "${FULL_PATH}")
        continue()
    endif()

    string(REPLACE "\\" "/" NORM_REL "${REL_PATH}")
    set(VIRTUAL_PATH "assets/${NORM_REL}")

    get_filename_component(EXT "${NORM_REL}" LAST_EXT)
    string(TOLOWER "${EXT}" EXT_LOWER)
    if (EXT_LOWER STREQUAL ".png")
        set(MIME_TYPE "png")
    elseif (EXT_LOWER STREQUAL ".svg")
        set(MIME_TYPE "svg")
    elseif (EXT_LOWER STREQUAL ".jpg" OR EXT_LOWER STREQUAL ".jpeg")
        set(MIME_TYPE "jpg")
    elseif (EXT_LOWER STREQUAL ".ttf")
        set(MIME_TYPE "ttf")
    elseif (EXT_LOWER STREQUAL ".otf")
        set(MIME_TYPE "otf")
    else()
        string(REGEX REPLACE "^\\." "" MIME_TYPE "${EXT_LOWER}")
    endif()

    file(SIZE "${FULL_PATH}" BYTE_SIZE)
    file(READ "${FULL_PATH}" HEX_CONTENT HEX)

    string(APPEND CPP_OUT "// ${VIRTUAL_PATH} (${BYTE_SIZE} bytes)\n")
    string(APPEND CPP_OUT "alignas(16) static constexpr uint8_t kAsset_${ASSET_IDX}[] = {\n")

    guikit_hex_to_c_array("${HEX_CONTENT}" FORMATTED_HEX)
    string(APPEND CPP_OUT "${FORMATTED_HEX}")

    # Append trailing null-terminator (not counted in BYTE_SIZE) for safe string/SVG loaders
    string(APPEND CPP_OUT "    0x00\n};\n\n")

    list(APPEND ENTRY_ROWS "    EmbeddedAssetEntry{\"${VIRTUAL_PATH}\", \"${MIME_TYPE}\", kAsset_${ASSET_IDX}, ${BYTE_SIZE}u}")
    math(EXPR ASSET_IDX "${ASSET_IDX} + 1")
endforeach()

if (ASSET_IDX GREATER 0)
    string(JOIN ",\n" JOINED_ROWS ${ENTRY_ROWS})
    string(APPEND CPP_OUT "static constexpr std::array<EmbeddedAssetEntry, ${ASSET_IDX}> kEmbeddedAssets = {{\n")
    string(APPEND CPP_OUT "${JOINED_ROWS}\n")
    string(APPEND CPP_OUT "}};\n\n")
    string(APPEND CPP_OUT "} // namespace\n\n")
    string(APPEND CPP_OUT "std::span<const EmbeddedAssetEntry> GetEmbeddedAssets() noexcept {\n")
    string(APPEND CPP_OUT "    return kEmbeddedAssets;\n")
    string(APPEND CPP_OUT "}\n\n")
else()
    string(APPEND CPP_OUT "} // namespace\n\n")
    string(APPEND CPP_OUT "std::span<const EmbeddedAssetEntry> GetEmbeddedAssets() noexcept {\n")
    string(APPEND CPP_OUT "    return {};\n")
    string(APPEND CPP_OUT "}\n\n")
endif()

string(APPEND CPP_OUT "} // namespace guikit::detail\n")

# Write atomically via configure/copy-if-different semantics
file(WRITE "${OUTPUT_FILE}.tmp" "${CPP_OUT}")
execute_process(
    COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${OUTPUT_FILE}.tmp" "${OUTPUT_FILE}"
)
file(REMOVE "${OUTPUT_FILE}.tmp")
